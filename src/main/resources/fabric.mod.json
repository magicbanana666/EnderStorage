{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_display_name}",
  "description": "Ender chests, tanks and pouches that share their contents with everything that has the same three colours.",
  "authors": ["magicbanana666"],
  "contact": {
    "homepage": "https://github.com/magicbanana666/EnderStorage",
    "sources": "https://github.com/magicbanana666/EnderStorage",
    "issues": "https://github.com/magicbanana666/EnderStorage/issues"
  },
  "license": "Don't Be an Asshole License (textures and models: MIT, see the licenses folder in the source)",
  "environment": "*",
  "entrypoints": {
    "main": ["com.magicbanana666.enderstorage.EnderStorage"],
    "client": ["com.magicbanana666.enderstorage.client.EnderStorageClient"],
    "modmenu": ["com.magicbanana666.enderstorage.client.EnderStorageModMenu"]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dep}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "ftbteams": "*"
  }
}
